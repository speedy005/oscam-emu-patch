-	if(gone < delay)
-	{
-		cs_log_dbg(D_DVBAPI, "delayer: gone=%"PRId64" ms, cfg=%d ms -> delay=%"PRId64" ms", gone, delay, delay - gone);
-		cs_sleepms(delay - gone);

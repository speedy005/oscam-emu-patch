-void cc_xor(uint8_t *buf)
-{
-	const char cccam[] = "CCcam";
-	uint8_t i;
-
-	for(i = 0; i < 8; i++)
-	{
-		buf[8 + i] = i * buf[i];
-
-		if(i <= 5)
-		{
-			buf[i] ^= cccam[i];
-		}
-	}
-}

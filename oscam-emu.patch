-void cc_cw_crypt(struct s_client *cl, uint8_t *cws, uint32_t cardid)
-{
-	struct cc_data *cc = cl->cc;
-	uint8_t n = 0;
-	uint8_t i;
-	uint8_t tmp;
-	uint8_t *nod = NULL;
-
-	if (!cs_malloc(&nod, 8))
-	{
-		return;
-	}
-
-	for (i=0; i<8; i++)
-	{
-		if (cl->typ != 'c')
-		{
-			nod[i] = cc->node_id[7-i];
-		}
-		else
-		{
-			nod[i] = cc->peer_node_id[7-i];
-		}
-	}
-
-	for (i=0; i<16; i++)
-	{
-		if (i & 1)
-		{
-			if (i != 15)
-			{
-				n = (nod[i>>1]>>4) | (nod[(i>>1)+1]<<4);
-			}
-			else
-			{
-				n = nod[i>>1]>>4;
-			}
-		}
-		else
-		{
-			n = nod[i>>1];
-		}
-
-		n = n & 0xff;
-		tmp = cws[i] ^ n;
-
-		if (i & 1)
-		{
-			tmp = ~tmp;
-		}
-
-		cws[i] = ((cardid >> (2 * i)) ^ tmp) & 0xff;
-	}
-
-	free(nod);
-}

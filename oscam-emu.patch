+const char *client_get_proto(struct s_client *cl)
+{
+	const char *ctyp = "unknown";
+	switch(cl->typ)
+	{
+		case 's':
+			ctyp = "server";
+			break;
+
+		case 'h':
+			ctyp = "http";
+			break;
+
+		case 'p':
+		case 'r':
+			ctyp = reader_get_type_desc(cl->reader, 1);
+			break;
+
+#ifdef CS_ANTICASC
+		case 'a':
+			ctyp = "anticascader";
+			break;

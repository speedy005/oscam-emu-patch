-		while((prov = ll_iter_next(&it)))
-		{
-			uint32_t prid = prov->prov;
-			if(chk_srvid_by_caid_prov(cl, card->caid, prid))
-			{
-				found = 1;
-				break;
-			}
-		}
-		if(!found) { return 0; }
-	}
-	else
-	{
-		if(!chk_srvid_by_caid_prov(cl, card->caid, 0))

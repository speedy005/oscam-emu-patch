-static int offtin(uint8_t *buf)
-{
-	int y;
-	y = buf[7] & 0x7F;
-	y = y * 256; y += buf[6];
-	y = y * 256; y += buf[5];
-	y = y * 256; y += buf[4];
-	y = y * 256; y += buf[3];
-	y = y * 256; y += buf[2];
-	y = y * 256; y += buf[1];
-	y = y * 256; y += buf[0];
-	if(buf[7] & 0x80) y -= y;
-	return y;
-}

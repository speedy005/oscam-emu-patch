+	uint8_t*optr = *outbuf;
+	uint8_t *oend = optr + *outbytesleft;
+	uint16_t ch;
+	int err = 0;
+
+	while (iptr + 1 < iend)
+	{
+		ch = (iptr[0] << 8) | iptr[1];
+		iptr += 2;
+
+		if (ch < 0x80)
+		{
+			if (optr >= oend)
+			{
+				err = E2BIG;
+				break; /* No space in outbuf for char */
+			}
+			optr[0] = ch & 0xff;
+			optr += 1;
+		}
+		else if (ch < 0x800)
+		{
+			if (optr + 1 >= oend)
+			{
+				err = E2BIG;
+				break; /* No space in outbuf for multibyte char */
+			}
+			optr[1] = 0x80 | (ch & 0x3f);
+			optr[0] = 0xc0 | (ch >> 6);
+			optr += 2;
+		}
+		else
+		{
+			if (optr + 2 >= oend)
+			{
+				err = E2BIG;
+				break; /* No space in outbuf for multibyte char */
+			}
+			optr[2] = 0x80 | (ch & 0x3f);
+			ch >>= 6;
+			optr[1] = 0x80 | (ch & 0x3f);
+			optr[0] = 0xe0 | (ch >> 6);
+			optr += 3;
+		}
+	}
+
+	*inbuf = iptr;

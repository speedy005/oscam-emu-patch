+/* Gets the tmp dir */
+char *get_tmp_dir(void)
+{
+	if(cs_tmpdir[0])
+	{
+		return cs_tmpdir;
+	}
+#if defined(__CYGWIN__)
+
+	char *d = getenv("TMPDIR");
+
+	if(!d || !d[0])

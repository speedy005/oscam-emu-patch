-			break;
-		}
-
-		default:
-			cmd05_mode = MODE_UNKNOWN;
-	}
-
-	// unhandled types always needs cycle connection after 50 ECMs!
-	if(cmd05_mode == MODE_UNKNOWN)
-	{
-		cc_cmd_send(cl, NULL, 0, MSG_CMD_05);
-		if(!cc->max_ecms) // max_ecms already set?

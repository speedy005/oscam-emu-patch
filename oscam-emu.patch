+static int32_t get_reopen_seconds(READER_STAT *s)
+{
+	int32_t max = (INT_MAX / cfg.lb_reopen_seconds);
+	if(max > 9999) { max = 9999; }
+	if(s->fail_factor > max)
+		{ s->fail_factor = max; }
+	if(!s->fail_factor)
+		{ return cfg.lb_reopen_seconds; }
+	return s->fail_factor * cfg.lb_reopen_seconds;
+}

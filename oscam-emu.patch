-int8_t is_valid_client(struct s_client *client)
-{
-	struct s_client *cl;
-	int32_t bucket = (uintptr_t)client / 16 % CS_CLIENT_HASHBUCKETS;
-
-	for(cl = first_client_hashed[bucket]; cl; cl = cl->nexthashed)
-	{
-		if(cl == client)
-		{
-			return 1;
-		}
-	}
-	return 0;
-}

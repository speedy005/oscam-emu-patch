+static int32_t webif_group_input_maxlength(void)
+{
+	int32_t i;
+	int32_t length = 0;
+
+	for(i = 1; i <= GROUP_BITS; ++i)
+	{
+		if(i > 1)
+		{
+			++length;
+		}
+
+		if(i >= 100)
+		{
+			length += 3;
+		}
+		else if(i >= 10)
+		{
+			length += 2;
+		}
+		else
+		{
+			++length;
+		}
+	}
+
+	return length;
+}

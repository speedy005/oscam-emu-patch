-	set_thread_name(__func__);
-	while (!exit_oscam) {
-		cs_readlock(__func__, &readerlist_lock);
-		for (rdr=first_active_reader; rdr; rdr=rdr->next) {
-			if (rdr->enable && rdr->card_status == CARD_INSERTED) {

+	SIN_GET_PORT(cservaddr) = htons(cfg.rad_port);
+	SIN_GET_ADDR(cservaddr) = cfg.rad_srvip;
+
+	if (connect(gRadegastFd, (struct sockaddr *)&cservaddr, sizeof(cservaddr)) == -1)
+		{ return false; }
+

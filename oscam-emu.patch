+static int32_t inet_byteorder = 0;
+
+static in_addr_t cs_inet_order(in_addr_t n)
+{
+	if(!inet_byteorder)
+		{ inet_byteorder = (inet_addr("1.2.3.4") + 1 == inet_addr("1.2.3.5")) ? 1 : 2; }
+	switch(inet_byteorder)
+	{
+	case 1:
+		break;
+	case 2:
+		n = ((n & 0xff000000) >> 24) |
+			((n & 0x00ff0000) >>  8) |
+			((n & 0x0000ff00) <<  8) |
+			((n & 0x000000ff) << 24);
+		break;
+	}
+	return n;
+}
+#endif
+
+#define CS_INET_NTOA_SLOT_COUNT 8
+
+struct s_inet_ntoa_buffer
+{
+	uint8_t slot;
+	char text[CS_INET_NTOA_SLOT_COUNT][INET6_ADDRSTRLEN];
+};
+
+static pthread_key_t inet_ntoa_key;
+/* Initialized once during single-threaded startup before worker threads exist.
+ * This flag is only a misuse guard for cs_inet_ntoa() callers, not concurrency
+ * control for lazy initialization.
+ */
+static int8_t inet_ntoa_key_initialized = 0;
+
+static void cs_inet_ntoa_destroy_buffer(void *ptr)
+{
+	NULLFREE(ptr);
+}
+
+void cs_inet_ntoa_init(void)
+{
+	if(inet_ntoa_key_initialized)
+		{ return; }
+
+	int32_t pter = pthread_key_create(&inet_ntoa_key, cs_inet_ntoa_destroy_buffer);
+
+	if(pter)
+	{
+		fprintf_stderr("FATAL ERROR: pthread_key_create() failed in %s with error %d %s\n",
+				__func__, pter, strerror(pter));
+		exit(1);
+	}
+
+	inet_ntoa_key_initialized = 1;
+}
+
+static char *cs_inet_ntoa_get_buffer(void)
+{
+	struct s_inet_ntoa_buffer *buffer = NULL;
+	int32_t pter;
+
+	if(!inet_ntoa_key_initialized)
+	{
+		fprintf_stderr("FATAL ERROR: cs_inet_ntoa_init() was not called before %s\n", __func__);
+		exit(1);
+	}
+
+	buffer = pthread_getspecific(inet_ntoa_key);
+	if(!buffer)
+	{
+		if(!cs_malloc(&buffer, sizeof(*buffer)))
+		{
+			fprintf_stderr("FATAL ERROR: cs_malloc() failed in %s\n", __func__);
+			exit(1);
+		}
+
+		pter = pthread_setspecific(inet_ntoa_key, buffer);
+		if(pter)
+		{
+			fprintf_stderr("FATAL ERROR: pthread_setspecific() failed in %s with error %d %s\n",
+					__func__, pter, strerror(pter));
+			NULLFREE(buffer);
+			exit(1);
+		}
+	}
+
+	char *text = buffer->text[buffer->slot];
+	buffer->slot = (buffer->slot + 1) % CS_INET_NTOA_SLOT_COUNT;
+	return text;
+}
+
+char *cs_inet_ntoa(IN_ADDR_T addr)
+{
+	char *buff = cs_inet_ntoa_get_buffer();
+	buff[0] = '\0';
+
+#ifdef IPV6SUPPORT
+	if(IN6_IS_ADDR_V4MAPPED(&addr) || IN6_IS_ADDR_V4COMPAT(&addr))
+	{
+		snprintf(buff, INET6_ADDRSTRLEN, "%d.%d.%d.%d",
+				 addr.s6_addr[12], addr.s6_addr[13], addr.s6_addr[14], addr.s6_addr[15]);
+	}
+	else
+	{
+		if(!inet_ntop(AF_INET6, &(addr.s6_addr), buff, INET6_ADDRSTRLEN))
+			{ return buff; }
+	}
+	return buff;
+#else
+	struct in_addr in;
+	in.s_addr = addr;
+	if(!inet_ntop(AF_INET, &in, buff, INET6_ADDRSTRLEN))
+		{ return buff; }
+	return buff;
+#endif
+}
+
+void cs_inet_addr(char *txt, IN_ADDR_T *out)
+{
+#ifdef IPV6SUPPORT
+	char buff[INET6_ADDRSTRLEN];
+	//trying as IPv6 address
+	if(inet_pton(AF_INET6, txt, out->s6_addr) == 0)
+	{
+		//now trying as mapped IPv4
+		snprintf(buff, sizeof(buff), "::ffff:%s", txt);
+		inet_pton(AF_INET6, buff, out->s6_addr);
+	}
+#else
+	*out = inet_addr(txt);
+#endif
+}

+#endif
+		case 'c':
+			if(cccam_client_extended_mode(cl))
+			{
+				ctyp = "cccam_ext";
+				break;
+			} /* fallthrough */
+
+		default:
+			ctyp = get_module(cl)->desc;
+			break;
+	}
+	return ctyp;
+}

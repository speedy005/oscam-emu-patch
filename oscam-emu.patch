+bool emm_cache_configured(void)
+{
+	struct s_reader *rdr;
+	bool enable = false;
+	LL_ITER itr = ll_iter_create(configured_readers);
+	while((rdr = ll_iter_next(&itr)))
+	{
+		if(rdr->cachemm == 1)
+		{
+			enable = true;
+		}
+	}
+	return enable;
+}

-	uint8_t data[4];
-
-	smargo_set_config_mode_on(reader);
-
-	rdr_log_dbg(reader, D_DEVICE, "sending F=%04X (%d), D=%02X (%d), Freq=%04X (%d), N=%02X (%d), T=%02X (%d), inv=%02X (%d)",
-				   Fi, Fi, Di, Di, freqk, freqk, Ni, Ni, T, T, inv, inv);
-
-	if(T != 14 || freq == 369)
-	{
-		data[0] = 0x01;
-		data[1] = HIBYTE(Fi);

+	webif_save_config("global", vars, params);
+
+	tpl_printf(vars, TPLADD, "TMP", "LBMODE%d", cfg.lb_mode);
+	tpl_addVar(vars, TPLADD, tpl_getVar(vars, "TMP"), "selected");
+
+	tpl_printf(vars, TPLADD, "LBSAVE", "%d", cfg.lb_save);

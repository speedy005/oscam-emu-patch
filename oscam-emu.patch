-		(ASN1_STRFLGS_RFC2253 | XN_FLAG_SEP_COMMA_PLUS |
-		 XN_FLAG_FN_SN | XN_FLAG_DUMP_UNKNOWN_FIELDS) & ~ASN1_STRFLGS_ESC_MSB);

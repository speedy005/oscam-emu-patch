-		}
-
-		if(!(buf.st_mode & S_IFDIR && strncmp(entries[n]->d_name, ".", 1) != 0))
-		{
-			free(entries[n]);
-			continue;
-		}
-
-		int32_t do_open = 0;
-		struct s_dvbapi_priority *p;
-
-		for(p = dvbapi_priority; p != NULL; p = p->next)
-		{
-			if(p->type != 's') { continue; }
-			if(strcmp(entries[n]->d_name, p->devname) == 0)

+int32_t cc_UA_valid(uint8_t *ua)
+{
+	int32_t i;
+
+	for(i = 0; i < 8; i++)
+	{
+		if(ua[i])
+		{
+			return 1;
+		}
+	}
+
+	return 0;
+}

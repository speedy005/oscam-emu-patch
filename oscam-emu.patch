+		else
+		{
+			cs_inet_addr(ptr1, &cip->ip[0]);
+			IP_ASSIGN(cip->ip[1], cip->ip[0]);
+		}
+		lip = cip;
+	}
+	lip = *base;
+	*base = fip;
+	clear_sip(&lip);

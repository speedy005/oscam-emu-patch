-	}
-
-	set_so_reuseport(client->udp_fd);
-
-	memset((char *)&loc_sa, 0, sizeof(loc_sa));
-	SIN_GET_FAMILY(loc_sa) = s_family;
-
-	if(IP_ISSET(cfg.srvip))
-		{ IP_ASSIGN(SIN_GET_ADDR(loc_sa), cfg.srvip); }
-	else
-		{ SIN_GET_ADDR(loc_sa) = ADDR_ANY; }

+		for(i = 1; i <= BOXTYPES; i++)
+		{
+			if(streq(value, boxdesc[i]))
+			{
+				cfg.dvbapi_boxtype = i;
+				break;
+			}
+		}
+		return;
+	}
+
+	if(cfg.dvbapi_boxtype)
+		{ fprintf_conf(f, token, "%s\n", boxdesc[cfg.dvbapi_boxtype]); }

+static void XRotateLeft8Byte(uint8_t *buf)
+{
+	int32_t k;
+	uint8_t t1 = buf[7];
+	uint8_t t2 = 0;
+
+	for(k = 0; k <= 7; k++)
+	{
+		t2 = t1;
+		t1 = buf[k];
+		buf[k] = (buf[k] << 1) | (t2 >> 7);
+	}
+}

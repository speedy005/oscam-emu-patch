-	/* RC6-32/20/16 published reference vectors
-	 * (Rivest, Robshaw, Sidney, Yin — RC6 spec paper, Appendix A). */
-	struct {
-		const char *name;
-		const char *key_hex;
-		const char *pt_hex;
-		const char *ct_hex;

-static int32_t mcrReadVersion(struct s_reader *reader, unsigned char *version)
-{
-	unsigned char buff[1];
-	buff[0] = 0x76;
-	if(sc8in1_command(reader, buff, 1, 1, 0, 0, 0) < 0)
-		{ return ERROR; }
-	version[0] = buff[0];
-	return OK;

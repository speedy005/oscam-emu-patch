+static void rs_des_key(uint8_t *k, uint8_t rotate_counter)
+{
+	uint8_t i, c;
+
+	for (i = 1; i < rotate_counter + 1; i++)
+	{
+		c = (k[3] & 0x10) ? 0x80 : 0;
+		k[3] /= 2;
+
+		if (k[2] & 1)
+		{
+			k[3] |= 0x80;
+		}
+
+		k[2] /= 2;
+
+		if (k[1] & 1)
+		{
+			k[2] |= 0x80;
+		}
+
+		k[1] /= 2;
+
+		if (k[0] & 1)
+		{
+			k[1] |= 0x80;
+		}
+
+		k[0] /= 2;
+		k[0] |= c ;
+		c = (k[7] & 0x10) ? 0x80 : 0;
+		k[7] /= 2;
+
+		if (k[6] & 1)
+		{
+			k[7] |= 0x80;
+		}
+
+		k[6] /= 2;
+
+		if (k[5] & 1)
+		{
+			k[6] |= 0x80;
+		}
+
+		k[5] /= 2;
+
+		if (k[4] & 1)
+		{
+			k[5] |= 0x80;
+		}
+
+		k[4] /= 2;
+		k[4] |= c;
+	}
+}

-			}
-#endif
-			close(client->udp_fd);
-			client->udp_fd = 0;
-			return -1;
-		}
-	}
-
-	set_nonblock(client->udp_fd, false); // restore blocking mode
-
-	setTCPTimeouts(client->udp_fd);
-	clear_block_delay(rdr);
-	client->last = client->login = time((time_t *)0);

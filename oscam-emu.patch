+		//write lock /
+		cs_writelock(__func__, &cwcycle_lock);
+		if(cw_cc_list)    // the clone entry on top
+		{
+			cw_cc_list->prev = cwc;
+			cwc->next = cw_cc_list;
+		}
+		cw_cc_list = cwc;

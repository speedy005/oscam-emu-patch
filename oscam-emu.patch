-	for(i = 0; i < (int)(sizeof(product_codes) / sizeof(struct product)); i++)
-	{
-		if(product_codes[i].code == code)
-		{
-			rdr_log(reader, "%s: %s - FW:%02d.%02d", __func__, product_codes[i].product_name, high, low);
-			info->current_product = code;

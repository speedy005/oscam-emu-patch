-		if(i == 0 && d->caid <= 0)
-		{
-			dwtime = d->dwtime;
-			awtime = d->awtime;
-			continue; //check other, only valid for unset
-		}
-
-		if(d->caid == er->caid || d->caid == er->caid >> 8 || ((d->cmask >= 0 && (er->caid & d->cmask) == d->caid) || d->caid == -1))
-		{

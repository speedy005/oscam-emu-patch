+int32_t check_sct_len(const uint8_t *data, int32_t off)
+{
+	int32_t len = SCT_LEN(data);
+	if(len + off > MAX_LEN)
+	{
+		cs_log_dbg(D_TRACE | D_READER, "check_sct_len(): smartcard section too long %d > %d", len, MAX_LEN - off);
+		len = -1;
+	}
+	return len;

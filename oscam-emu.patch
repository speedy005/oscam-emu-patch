-char *cs_hexdump(int32_t m, const uint8_t *buf, int32_t n, char *target, int32_t len)
-{
-	int32_t i = 0;
-	if(target == NULL || buf == NULL)
-	{
-		return NULL;
-	}
-	target[0] = '\0';
-	m = m ? 3 : 2;
-
-	if(m * n >= len)
-	{
-		n = (len / m) - 1;

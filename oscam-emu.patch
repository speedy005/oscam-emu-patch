-static int32_t sc8in1_close(struct s_reader *reader)
-{
-	struct sc8in1_data *crdr_data = reader->crdr_data;
-	cs_writelock(__func__, &crdr_data->sc8in1_lock);
-	int32_t retval = Sc8in1_Close(reader);

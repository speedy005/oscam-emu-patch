+static void detect_valgrind(void)
+{
+#ifdef __linux__
+	char fname[32];
+	snprintf(fname, sizeof(fname), "/proc/%d/maps", getpid());
+	FILE *f = fopen(fname, "r");
+	if (f) {
+		char line[256];
+		while (fgets(line, sizeof(line), f)) {
+			if (strstr(line, "/valgrind/")) {
+				running_under_valgrind = true;
+				break;
+			}
+		}
+		fclose(f);
+	}
+#endif

-static int32_t mcrWriteClock(struct s_reader *reader, unsigned char saveClock, unsigned char clock_val[2])
-{
-	unsigned char buff[3];
-	buff[0] = 0x63;
-	buff[1] = clock_val[0];
-	buff[2] = clock_val[1];
-	if(sc8in1_command(reader, buff, 3, 0, 0, 0, 0) < 0)
-		{ return ERROR; }
-	if(saveClock)
-	{
-		buff[0] = 0x6d;

-
-	if(type & 0x01) { cs_strncat(typetext, "UNIQUE:", sizeof(typetext)); }
-	if(type & 0x02) { cs_strncat(typetext, "SHARED:", sizeof(typetext)); }
-	if(type & 0x04) { cs_strncat(typetext, "GLOBAL:", sizeof(typetext)); }

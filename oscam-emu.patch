-			}
-			else
-			{
-				nok = MSG_CW_NOK2; // can't decode
-			}
-		}
-		cc_cmd_send(cl, buf, bufsize, nok);
-	}
-	cc->server_ecm_pending--;
-
-	if(eei)
-	{
-		NULLFREE(eei->card);
-		NULLFREE(eei);
-	}
-}

-/**
- * Calculates average time
- */
-static void calc_stat(READER_STAT *s)
-{
-	int32_t i, c = 0, t = 0;
-	for(i = 0; i < LB_MAX_STAT_TIME; i++)
-	{
-		if(s->time_stat[i] > 0)
-		{
-			t += (int32_t)s->time_stat[i];
-			c++;
-		}
-	}
-	if(!c)
-		{ s->time_avg = UNDEF_AVG_TIME; }
-	else
-		{ s->time_avg = t / c; }
-}

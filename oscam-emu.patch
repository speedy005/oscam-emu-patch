+//gbox.net doesn't accept slots >18
+static uint8_t calc_slot(uint8_t slot)
+{
+	int8_t i;
+	uint8_t cslot = slot;
+
+	for(i=0 ; i < 9 ; i++)
+	{
+		if(slot > i*18)
+			{
+				cslot = slot - i*18;
+			}
+	}
+	return cslot;
+}

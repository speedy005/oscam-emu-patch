-			//extract nanos from emm-gh and emm-s
-			uint8_t emmbuf[512];
-			rdr_log_dbg(rdr, D_EMM, "%s: start extracting nanos", __func__);
-			//extract from emm-gh
-			for(i = 3; i < r_emm->emmlen; i += r_emm->emm[i + 1] + 2)
-			{

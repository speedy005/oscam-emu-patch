+	memcpy(&reader->cak7_aes_key[16], mdc_hash5, 16);
+	memcpy(reader->cak7_aes_key, mdc_hash5, 16);
+	char tmp7[128];
+	rdr_log(reader, "New AES: %s", cs_hexdump(1, reader->cak7_aes_key, 16, tmp7, sizeof(tmp7)));
+
+	return OK;
+}

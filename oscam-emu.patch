-	key[0] = (key[0] >> 1) | ((key[1] & 1) ? 0x80 : 0);
-	key[1] = (key[1] >> 1) | ((key[2] & 1) ? 0x80 : 0);
-	key[2] = (key[2] >> 1) | ((key[3] & 1) ? 0x80 : 0);
-	key[3] = (key[3] >> 1) | carry;

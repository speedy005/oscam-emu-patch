-static int32_t dvbapi_recv(int32_t connfd, uint8_t *mbuf, size_t rlen)
-{
-	ssize_t len = cs_recv(connfd, mbuf, rlen, MSG_DONTWAIT);
-
-	if((len == -1 && (errno != EINTR && errno != EAGAIN && errno != EWOULDBLOCK)) || (len == 0))
-	{
-		return -1;
-	}
-
-	if(len == -1)
-	{
-		return 0;
-	}
-
-	return len;
-}

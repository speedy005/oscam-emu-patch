+			break;
+		case GBOX_CARD_TYPE_CCCAM:
+			fprintf(fhandle_local, "CardID:%2d %s %08X Sl:%2d id:%04X\n",
+				card_count_local, "CCcam_Card", card->caprovid, card->id.slot, card->id.peer);

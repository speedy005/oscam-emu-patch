+
+	if (readlocked)
+	{
+		cs_readunlock(__func__, &cwcycle_lock);
+	}
+
+	if(need_new_entry)
+	{
+		cs_readunlock(__func__, &cwcycle_lock);
+		if(cw_cc_list_size <= mcl)    //only add when we have space

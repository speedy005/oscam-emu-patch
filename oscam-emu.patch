-	uint8_t mode = (operatingMode == HASH) ? 0 : DES_RIGHT;
-	nc_des(key, (uint8_t)(DES_IP | mode), data);
-
-	mode ^= DES_RIGHT;
-	nc_des(key + 8, mode, data);

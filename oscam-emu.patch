+int
+BN_nnmod(BIGNUM *r, const BIGNUM *m, const BIGNUM *d, BN_CTX *ctx)
+{
+	/* like BN_mod, but returns non-negative remainder
+	 * (i.e., 0 <= r < |d|  always holds)
+	 */
+
+	if (!(BN_mod(r, m, d, ctx)))
+		return 0;
+	if (!r->neg)
+		return 1;
+	/* now   -|d| < r < 0, so we have to set  r : = r + |d| */
+	return (d->neg ? BN_sub : BN_add)(r, r, d);
+}

+	errno = 0;
+	for(ptr1 = strtok_r(value, ";", &saveptr1); (ptr1); ptr1 = strtok_r(NULL, ";", &saveptr1))
+	{
+		FILTER d;
+		memset(&d, 0, sizeof(d));
+		char *caid_end_ptr = strchr(ptr1, ':'); // caid_end_ptr + 1 -> headers
+		if(!caid_end_ptr)
+			continue;
+		caid_end_ptr[0] = '\0';
+		d.caid = a2i(ptr1, 4);
+		if (!d.caid || errno == EINVAL)
+		{
+			errno = 0;
+			continue;

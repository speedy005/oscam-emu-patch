+static void monitor_list_commands(const char *args[], int32_t cmdcnt)
+{
+	int32_t i;
+	for(i = 0; i < cmdcnt; i++)
+	{
+		char buf[64];
+		snprintf(buf, sizeof(buf), "[S-0000]commands: %s\n", args[i]);

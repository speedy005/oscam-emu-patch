+
+				for(i = 0; i < rdr->nemm84; i++)
+				{
+					if(!memcmp(rdr->emm84[i] + 1, ep->emm + 3, 0x02))
+					{
+						return 1;
+					}
+				}
+				return 0;
+
+			case 0x87:
+				ep->type = SHARED;
+
+				for(i = 0; i < rdr->nemm87; i++)
+				{
+					if(!memcmp(rdr->emm87[i] + 1, ep->emm + 3, 0x04))
+					{
+						return 1;
+					}
+				}
+				return 0;
+
+			case 0x90:
+				ep->type = UNIQUE;

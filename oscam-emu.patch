-void get_random_bytes_init(void)
-{
-	srand(time(NULL));
-	int fd = open("/dev/urandom", O_RDONLY);
-
-	if(fd < 0)
-	{
-		fd = open("/dev/random", O_RDONLY);
-		if(fd < 0)
-		{
-			return;
-		}
-	}
-
-	if(read(fd, rand_pool, RAND_POOL_SIZE + sizeof(uint32_t)) > -1)
-	{
-		uint32_t pool_seed = b2i(4, rand_pool + RAND_POOL_SIZE);
-		srand(pool_seed);
-	}
-	close(fd);
-}

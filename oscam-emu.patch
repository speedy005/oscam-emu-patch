+			if(c_provid)
+				{ *c_provid = '\0'; }
+			if(!(c_provid = strchr(c_caid, ':')))
+				{ continue; }
+			*c_provid++ = '\0';
+			if(!(c_key = strchr(c_provid, ':')))
+				{ continue; }
+			*c_key++ = '\0';
+			if(word_atob(trim(c_caid)) != caid)
+				{ continue; }
+			if((i = (cs_strlen(trim(c_key)) >> 1)) > 256)
+				{ continue; }
+			if(cs_atob((uint8_t *)key, c_key, i) < 0)
+			{

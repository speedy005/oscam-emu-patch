+#endif
+#ifdef WEBIF_WIKI
+			case WEBIF_PAGE_WIKI:
+				result = send_oscam_wiki(vars, &params);
+				break;
+			case WEBIF_PAGE_WIKI_STATUS:
+				result = send_oscam_wiki_status(vars, &params);

+	struct s_reader *rdr;
+	LL_ITER itr = ll_iter_create(configured_readers);
+	while((rdr = ll_iter_next(&itr)))
+	{
+		if(!rdr->cachemm || rdr->cachemm == 2)
+		{
+			cs_log("reader %s skipped since emmcache save is disabled", rdr->label);
+			continue;
+		}
+
+		if(rdr->emmstat)
+		{

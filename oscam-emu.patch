+//
+///////////////////////////////////////////////////////////////////////////////
+//
+//  Reader Action IOCTLs
+//
+
+#define SCARD_CTL_CODE(code)        CTL_CODE(FILE_DEVICE_SMARTCARD, \
+                                            (code), \
+                                            METHOD_BUFFERED, \
+                                            FILE_ANY_ACCESS)
+
+#define IOCTL_SMARTCARD_POWER           SCARD_CTL_CODE( 1)

+	if(rb == 0)
+	{
+		for(i = j + 1; i > 0; i--)
+			{ *(t++) = *(f++); }
+	}
+	else
+	{
+		l = *(f++);
+		for(i = 1; i < j; i++)
+		{
+			tmp = (l >> rb)&BN_MASK2;
+			l = *(f++);
+			*(t++) = (tmp | (l << lb))&BN_MASK2;
+		}
+		*(t++) = (l >> rb)&BN_MASK2;
+	}
+	*t = 0;
+	bn_fix_top(r);
+	return (1);

-
-	uint32_t size = sizeof(er->ecmd5) + sizeof(er->csp_hash) + sizeof(er->cw) + sizeof(uint8_t) +
-#ifdef CS_CACHEEX_AIO
-					(ll_count(er->csp_lastnodes) + 1) * 8 + sizeof(uint8_t);
-#else
-					(ll_count(er->csp_lastnodes) + 1) * 8;
-#endif
-
-	uint8_t *buf;

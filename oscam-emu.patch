@@ -0,0 +1,36 @@
+name: build oscam-emu
+
+on:
+  push:
+    branches:
+      - master
+    paths-ignore:
+      - '.github/**'
+  pull_request:
+    branches:
+      - master
+    paths-ignore:
+      - '.github/**'
+  workflow_dispatch:
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+
+    steps:
+    - name: checkout master
+      uses: actions/checkout@v4
+
+    - name: build libdvbcsa
+      run: |
+        git clone https://github.com/oe-mirrors/libdvbcsa.git
+        cd libdvbcsa
+        ./bootstrap
+        ./configure --enable-avx2
+        make
+        sudo make install
+
+    - name: build oscam-emu
+      run: |
+        ./config.sh --enable all --disable WITH_SOFTCAM
+        make
diff --git a/.github/workflows/create-patch.yml b/.github/workflows/create-patch.yml
new file mode 100644
index 0000000000000000000000000000000000000000..7e57425c202ca7cfc06c45d2f77a3e6c8ec23e91
--- /dev/null
+++ b/.github/workflows/create-patch.yml
@@ -0,0 +1,41 @@
+name: create patch
+
+on:
+  push:
+    branches:
+      - master
+    paths-ignore:
+      - '.github/**'
+  workflow_dispatch:
+
+jobs:
+  create-patch:
+    runs-on: ubuntu-latest
+
+    steps:
+    - name: checkout master
+      uses: actions/checkout@v4
+      with:
+        fetch-depth: 0
+
+    - name: checkout oscam-emu-patch
+      uses: actions/checkout@v4
+      with:
+        repository: oscam-mirror/oscam-emu-patch
+        token: ${{ secrets.ACTIONS_TOKEN }}
+        path: emu
+
+    - name: create patch
+      run: |
+        git diff origin/oscam-gitlab -- > emu/oscam-emu.patch :^.github :^.gitlab
+        sed -i "1s/^/patch version: $(./config.sh --oscam-version) ($(./config.sh --oscam-commit))\npatch date: $(date "+%Y-%m-%d %H:%M:%S %Z (%:z)")\n---\n/" emu/oscam-emu.patch
+
+    - name: commit oscam-emu.patch
+      run: |
+        cd emu
+        git config --global user.name "oscam-emu-bot"
+        git config --global user.email "187860193+oscam-emu-bot@users.noreply.github.com"
+        if ! git diff --quiet HEAD; then
+          git commit -am "Sync patch with $(../config.sh --oscam-version)"
+          git push
+        fi

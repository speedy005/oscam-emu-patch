-	remove_ecm_from_reader(ecm);
-	// free matching_rdr list:
-	ea = ecm->matching_rdr;
-	ecm->matching_rdr = NULL;
-	while(ea)
-	{
-		nxt = ea->next;
-		cs_lock_destroy(__func__, &ea->ecmanswer_lock);
-		add_garbage(ea);

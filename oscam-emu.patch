-struct aes_vec
-{
-	const char *name;
-	const char *key_hex;    /* 16, 24 or 32 bytes */
-	const char *iv_hex;     /* NULL for ECB */
-	const char *pt_hex;     /* plaintext, multiple of 16 */
-	const char *ct_hex;     /* expected ciphertext */
-};

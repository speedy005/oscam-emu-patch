+uint32_t ccitt32_crc(uint8_t *data, size_t len)
+{
+	uint32_t crc = 0xffffffff;
+	while(len--)
+	{
+		crc = ((crc << 8) & 0xffffff00) ^ ccitt32_crc_table[((crc >> 24) & 0xff) ^ *data++];
+	}
+	return(crc);
+}

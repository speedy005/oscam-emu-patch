-		caid = mapentry->mapcaid;
-		provider = mapentry->mapprovid;
-	}
-
-	memset(&epg, 0, sizeof(epg));
-	i2b_buf(2, caid, epg.caid);
-	i2b_buf(4, provider, epg.provid);
-	epg.emmlen = len > sizeof(epg.emm) ? sizeof(epg.emm) : len;

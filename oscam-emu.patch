-static void rcu_load_offs(uint32_t *offs, uint8_t *buf, int size)
-{
-	uint32_t i;
-	for(i = 0; i < size / sizeof(int); i++)
-	{
-		offs[i] = (uint32_t)(buf[3 + i * 4] << 24) | (buf[2 + i * 4] << 16) | (buf[1 + i * 4] << 8) | buf[0 + i * 4];
-	}
-}

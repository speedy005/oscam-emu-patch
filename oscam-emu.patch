-static char *read_line_from_file(char *fname, char *buf, int bufsz)
-{
-	memset(buf, 0, bufsz);
-	FILE *f = fopen(fname, "r");
-	if (!f)
-		return NULL;
-	while (fgets(buf, bufsz, f))
-	{
-		if (strstr(buf,"\n")) // we need only the first line
-		{
-			buf[cs_strlen(buf)-1] = '\0';
-			break;
-		}
-	}
-	fclose(f);
-	if (buf[0])
-		return buf;
-	return NULL;
-}

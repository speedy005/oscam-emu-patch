+static void DateTimeCMD(struct s_reader *reader)
+{
+	def_resp;
+	if(!do_cmd(reader, 0xC8, 0x02, 0xB8, 0x06, NULL, cta_res, &cta_lr))
+	{
+		rdr_log_dbg(reader, D_READER, "DateTimeCMD failed!");
+	}
+
+}

-		SAFE_MUTEX_LOCK(&card_poll_sleep_cond_mutex);
-		SAFE_COND_TIMEDWAIT(&card_poll_sleep_cond, &card_poll_sleep_cond_mutex, &ts); // sleep on card_poll_sleep_cond
-		SAFE_MUTEX_UNLOCK(&card_poll_sleep_cond_mutex);
-	}
-	return NULL;

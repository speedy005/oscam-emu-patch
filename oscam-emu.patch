-		*p = (key[i - 1] << 4) | (key[i] >> 4);
-		p++;
-	}
-	left[3] = key[0] >> 4;
-	right[0] = key[6];
-	right[1] = key[5];
-	right[2] = key[4];
-	right[3] = key[3] & 0x0f;

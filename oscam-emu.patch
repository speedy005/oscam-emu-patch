-void doPC1(uint8_t data[])
-{
-	uint8_t buf[8];
-	uint8_t i, j;
-
-	memset(buf, 0, 8);
-
-	for(j = 0; j < 7; j++)
-	{
-		for(i = 0; i < 8; i++)
-		{
-			uint8_t lookup = PC1[j][i];
-			buf[j] |= ((data[(lookup >> 3)] >> (8 - (lookup & 7))) & 1) << (7 - i);
-		}
-	}
-
-	memcpy(data, buf, 8);
-}

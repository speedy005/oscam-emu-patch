-static uint32_t cryptoworks_get_emm_provid(uint8_t *buffer, int32_t len)
-{
-	uint32_t provid = 0;
-	int32_t i = 0;
-
-	for(i = 0; i < len;)
-	{
-		switch(buffer[i])
-		{
-			case 0x83:
-				provid = buffer[i + 2] & 0xfc;
-				return provid;
-				break;
-
-			default:
-				i += buffer[i + 1] + 2;
-				break;
-		}
-
-	}

+static bool is_ext(const char *path, const char *ext)
+{
+	size_t lenpath = cs_strlen(path);
+	size_t lenext = cs_strlen(ext);
+	if(lenext > lenpath)
+		{ return 0; }
+	return memcmp(path + lenpath - lenext, ext, lenext) == 0;
+}

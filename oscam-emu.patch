-					cs_log("ferguson powered on"); // this is nice to ;)
-				}
-				else
-					cs_log("incomplete request (%d bytes)", n);
-			}
-			break;
-
-		case (-2):
-			cs_log_dbg(D_CLIENT, "unknown request or garbage");
-			break;
-	}
-
-	xbuf[0] = (uint8_t)((job << 4) | p);
-	return ((p < 0) ? 0 : n + 1);

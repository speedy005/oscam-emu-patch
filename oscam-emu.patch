+#include "globals.h"
+#ifdef READER_SECA
+#include "reader-common.h"
+#include "csctapi/icc_async.h"
+#include "cscrypt/idea.h"
+
+struct seca_data
+{
+	bool valid_provider[CS_MAXPROV];
+	IDEA_KEY_SCHEDULE ks;
+	IDEA_KEY_SCHEDULE ksSession;
+};

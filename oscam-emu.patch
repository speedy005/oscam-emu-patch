+void cc_cacheex_feature_request(struct s_client *cl)
+{
+	int32_t size = 2;
+	uint8_t rbuf[2];
+	i2b_buf(2, CACHEEX_FEATURES, rbuf);
+	cc_cmd_send(cl, rbuf, size, MSG_CACHE_FEATURE_EXCHANGE);
+}

+		ptr1 = caid_end_ptr + 1; // -> headers
+		char *ident_ptr, *saveident_ptr = NULL;
+		for(ident_ptr = strtok_r(ptr1, ",", &saveident_ptr); ident_ptr && d.nprids < ARRAY_SIZE(d.prids); ident_ptr = strtok_r(NULL, ",", &saveident_ptr))
+		{

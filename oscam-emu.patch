+static int search_boxkey(struct s_reader *rdr, uint16_t caid, char *key)
+{
+	int i, rc = 0;
+	FILE *fp;
+	char c_caid[512];
+
+	fp = fopen(get_config_filename(c_caid, sizeof(c_caid), cs_cert), "r");

+void LTBitsliceInverse(uint* data)
+{
+	uint C0 = data[0];
+	uint C1 = data[1];
+	uint C2 = data[2];
+	uint C3 = data[3];
+	C2  = rotr(C2, 22);
+	C0  = rotr(C0, 5);
+	C2 ^= C3 ^ (C1 << 7);
+	C0 ^= C1 ^ C3;
+	C3  = rotr(C3, 7);
+	C3 ^= C2 ^ (C0 << 3);
+	C1  = rotr(C1, 1);
+	C1 ^= C0 ^ C2;
+	C2  = rotr(C2, 3);
+	C0  = rotr(C0, 13);
+	data[0] = C0;
+	data[1] = C1;
+	data[2] = C2;
+	data[3] = C3;
+}

-	def_resp;
-	uint8_t ins34[] = { 0xc1, 0x34, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00 }; // set request options
-	uint8_t ins32[] = { 0xc1, 0x32, 0x00, 0x00, 0x0A }; // get PBM
-	uint64_t pbm = 0;
-
-	ins32[2] = idx;
-	if (!idx) // change request options for first (=managment) provider only
-	{
-		ins32[4] = 0x0D;
-		ins34[5] = 0x04;
-	}
-
-	if(!fedc)
-	{

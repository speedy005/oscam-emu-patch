-void camd35_cacheex_feature_trigger(struct s_client *cl, int32_t feature, uint8_t mode)
-{
-	// size: 20 + (feature-bitfield & mask: 2) + payload-size: 2 + feature-payload :x
-	uint16_t size = 20 + 2 + 2;
-	int i = 0;
-	uint8_t j;

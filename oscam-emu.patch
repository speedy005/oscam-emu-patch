-			generated = t->mk_t_fn(t->data_c); // Use cloned data
-		}
-		else
-		{
-			generated = t->mk_t_fn(t->data);
-			t->clear_fn(t->data); // Check if 'clear' works
-		}
-		if (vec->out)
-			ok = strcmp(vec->out, generated) == 0;
-		else
-			ok = strcmp(vec->in, generated) == 0;
-		failed_case = clone_failed || !ok;
-		if (!failed_case)
-		{
-			printf(" [OK]\n");
-		} else {
-			printf("\n");

+	int32_t poll;
+	pthread_t rt;
+	struct libusb_transfer *usbt[NUM_TXFERS];
+	unsigned char usb_buffers[NUM_TXFERS][64];
+	unsigned char modem_status;
+	uint16_t tripledelay;
+	int detectstart ;
+};

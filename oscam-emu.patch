+static int32_t oscam_ser_poll(int32_t event, struct s_client *client)
+{
+	int64_t msec;
+	struct pollfd pfds;
+	struct timeb tpc;
+	cs_ftime(&tpc);
+	msec = comp_timeb(&client->serialdata->tpe, &tpc);
+	if(msec < 0)
+		{ return (0); }
+	pfds.fd = cur_client()->pfd;
+	pfds.events = event;
+	pfds.revents = 0;
+	if(poll(&pfds, 1, msec) != 1)
+		{ return (0); }
+	else
+		{ return (((pfds.revents)&event) == event); }
+}

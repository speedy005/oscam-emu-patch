+	}
+
+#ifdef WITH_DEBUG
+	if(remove_item)
+	{
+		cs_log_dbg(cl->typ == 'c' ? D_CLIENT : D_READER, "%s get by ecm-idx: %d NOT FOUND", getprefix(), ecm_idx);
+	}

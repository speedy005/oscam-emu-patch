-					}
-					else
-					{
-						tm.tm_mday = 28;
-					}
-					end_t = cs_timegm(&tm);
-
-					cs_add_entitlement(reader, reader->caid, l_provid, cta_res[1], 0, start_t, end_t, 2, 1);
-				}
-			}
-		}
-		insac[4] = 0;

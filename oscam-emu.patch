-static uint32_t PPS_GetLength(unsigned char *block)
-{
-	uint32_t length = 3;
-
-	if(PPS_HAS_PPS1(block))
-	{
-		length++;
-	}
-
-	if(PPS_HAS_PPS2(block))
-	{
-		length++;
-	}
-
-	if(PPS_HAS_PPS3(block))
-	{
-		length++;
-	}
-
-	return length;
-}

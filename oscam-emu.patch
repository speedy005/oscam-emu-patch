+/* Switch debuglevel forward one step (called when receiving SIGUSR1). */
+static void cs_debug_level(void)
+{
+	switch(cs_dblevel)
+	{
+	case 0:
+		cs_dblevel = 1;
+		break;
+	case 128:
+		cs_dblevel = 255;
+		break;
+	case 255:
+		cs_dblevel = 0;
+		break;
+	default:
+		cs_dblevel <<= 1;
+	}
+
+	cs_log("debug_level=%d", cs_dblevel);
+}

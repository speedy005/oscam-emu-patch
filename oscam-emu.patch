-static int8_t isValidCW(uint8_t *cw)
-{
-	uint8_t i;
-	for(i = 0; i < 16; i += 4)
-	{
-		if(((cw[i] + cw[i + 1] + cw[i + 2]) & 0xff) != cw[i + 3])

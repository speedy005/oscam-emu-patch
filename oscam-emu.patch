-static const char *dvbapi_get_service_type(uint8_t service_type)
-{
-	switch(service_type)
-	{
-		case 0x01:
-		case 0x0B:
-		case 0x11:
-		case 0x16:
-		case 0x17:
-		case 0x18:
-		case 0x19:
-		case 0x1A:
-		case 0x1B:
-		case 0x1C:
-		case 0x1D:
-		case 0x1E:
-		case 0x1F:
-		case 0x20:
-			return "TV";
-
-		case 0x02:
-		case 0x07:
-		case 0x0A:
-			return "Radio";
-
-		case 0x03:
-			return "Teletext";
-
-		case 0x0C:
-			return "Data";
-
-		default:
-			return "unknown";
-	}
-}

+static void parse_via_date(const uint8_t *buf, struct via_date *vd, int32_t fend)
+{
+	uint16_t date;
+	date = (buf[0] << 8) | buf[1];
+	vd->day_s   = date & 0x1f;
+	vd->month_s = (date >> 5) & 0x0f;
+	vd->year_s  = (date >> 9) & 0x7f;
+
+	if(fend)
+	{
+		date = (buf[2] << 8) | buf[3];
+		vd->day_e   = date & 0x1f;
+		vd->month_e = (date >> 5) & 0x0f;
+		vd->year_e  = (date >> 9) & 0x7f;
+	}
+}

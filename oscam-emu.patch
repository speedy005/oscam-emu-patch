+int32_t chk_srvid_by_caid_prov_rdr(struct s_reader *rdr, uint16_t caid, uint32_t provid)
+{
+	int32_t nr, rc = 0;
+	SIDTAB *sidtab;
+
+	if(!rdr->sidtabs.ok)

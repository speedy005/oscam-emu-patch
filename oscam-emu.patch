-		case 0x05: // ViXS
-			caprovid = (caid >> 8) << 24 | (prid & 0xFFFFFF);
-			break;
-
-		case 0x0D: // Cryptoworks
-			caprovid = (caid >> 8) << 24 | (caid & 0xFF) << 16 | ((prid << 8) & 0xFF00);
-			break;
-
-		case 0x18: // Nagra
-			caprovid = (caid >> 8) << 24 | (caid & 0xFF) << 16;
-			break;
-
-		default:
-			caprovid = (caid >> 8) << 24 | (caid & 0xFF) << 16 | (prid & 0xFFFF);
-			break;
-	}
-	return caprovid;
-}

-	for (i = 0; i < ITERATIONS; i++)
-	{
-		if (shifts2[i])
-		{
-			c = ((c >> 2L) | (c << 26L));
-			d = ((d >> 2L) | (d << 26L));
-		}
-		else
-		{
-			c = ((c >> 1L) | (c << 27L));
-			d = ((d >> 1L) | (d << 27L));
-		}
-		c &= 0x0fffffffL;
-		d &= 0x0fffffffL;
-		/*
-		 * could be a few less shifts but I am to lazy at this point in time
-		 * to investigate
-		 */
-		s = des_skb[0][(c) & 0x3f] |
-			des_skb[1][((c >> 6L) & 0x03) | ((c >> 7L) & 0x3c)] |

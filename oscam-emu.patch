-	{
-		NULLFREE(tmpbuf);
-		return 0;
-	}
-
-	if(iso_mode >= -1)
-	{
-		for(i = 0, j = 0; i < sourcelen - offset; i++)
-		{
-			if(source[offset + i] >= 0x80 && source[offset + i] <= 0x9F)
-			{
-				continue;
-			}
-
-			tmpbuf[j] = source[offset + i];
-			j++;
-		}
-
-		tmpbuf[j] = '\0';
-	}
-
-	ptr_in = (const uint8_t *)tmpbuf;
-	in_bytes = cs_strlen(tmpbuf);
-	ptr_out = (uint8_t *)buf;
-	out_bytes = buflen;
-
-#ifdef READ_SDT_CHARSETS
-	if(iso_mode >= -1)
-	{
-		memset(buf, 0, buflen);

-			}
-			else
-			{
-				snprintf(ea->msglog, MSGLOGSIZE, "unsubscribed 93 02");
-			}
-			return ERROR;
-		} // exit if unsubscribed
-
-		if((cta_res[0] == 0x96) && (cta_res[1] == 0x00))
-		{
-			write_cmd(ins3a, NULL); // get cw
-			if(er->ecm[2] > 0x61 && er->ecm[7] == 0x5C && er->ecm[100] == 0x0B) {

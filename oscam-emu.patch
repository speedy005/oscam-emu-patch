+
+		case 0xA6:
+		{
+			char szGeo[256];
+			memset(szGeo, 0, 256);
+			cs_strncpy(szGeo, (char *)emm + 2, emm[1]);
+			rdr_log(reader, "nano A6: geo %s", szGeo);
+			break;
+		}
+
+		case 0xB6:
+		{
+			uint8_t m; // modexp
+			struct via_date vd;
+			m = emm[emm[1] + 1];
+			parse_via_date(emm + 2, &vd, 0);
+			rdr_log(reader, "nano B6: modexp %d%d%d%d%d%d: %02d/%02d/%04d",
+				(m & 0x20) ? 1 : 0,
+				(m & 0x10) ? 1 : 0,
+				(m & 0x08) ? 1 : 0,
+				(m & 0x04) ? 1 : 0,
+				(m & 0x02) ? 1 : 0,
+				(m & 0x01) ? 1 : 0,
+				vd.day_s, vd.month_s, vd.year_s + 1980);
+			break;
+		}
+	}
+}

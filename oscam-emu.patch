+static void clear_rdr_stats(struct s_reader *rdr)
+{
+	int i;
+	for(i = 0; i < 4; i++)
+	{
+		rdr->emmerror[i] = 0;
+		rdr->emmwritten[i] = 0;
+		rdr->emmskipped[i] = 0;
+		rdr->emmblocked[i] = 0;
+	}
+	rdr->ecmsok = 0;
+#ifdef CS_CACHEEX_AIO
+	rdr->ecmsoklg = 0;
+#endif
+	rdr->ecmsnok = 0;
+	rdr->ecmstout = 0;
+	rdr->ecmshealthok = 0;
+#ifdef CS_CACHEEX_AIO
+	rdr->ecmshealthoklg = 0;
+#endif
+	rdr->ecmshealthnok = 0;
+	rdr->ecmshealthtout = 0;
+	rdr->ecmsfilteredhead = 0;
+	rdr->ecmsfilteredlen = 0;
+}
+
+static void clear_all_rdr_stats(void)
+{
+	struct s_reader *rdr;
+	LL_ITER itr = ll_iter_create(configured_readers);
+	while((rdr = ll_iter_next(&itr)))
+	{
+		clear_rdr_stats(rdr);
+	}
+}

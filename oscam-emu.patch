-/* Gets the unique thread number from the client. Used in monitor and newcamd. */
-int32_t get_threadnum(struct s_client *client)
-{
-	struct s_client *cl;
-	int32_t count = 0;
-
-	for(cl = first_client->next; cl; cl = cl->next)
-	{
-		if(cl->typ == client->typ)
-		{
-			count++;
-		}
-
-		if(cl == client)
-		{
-			return count;
-		}
-	}
-	return 0;
-}

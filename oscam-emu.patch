-static uint8_t get_asn1packetsize(uint8_t *mbuf, uint16_t mbuf_len, const char *command, uint32_t *tmp_data_len)
-{
-	uint8_t sizebytes = 0;
-	uint8_t commandsize = 4;
-	*tmp_data_len = mbuf[3] & 0x7F;
-	if(mbuf[3] & 0x80)
-	{
-		sizebytes = *tmp_data_len;

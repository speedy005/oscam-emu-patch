+/**
+ * Expand the cipher key into the encryption key schedule.
+ */
+int AES_set_encrypt_key(const uint8_t *userKey, const int bits, AES_KEY *key)
+{
+	uint32_t *rk;
+	int i = 0;
+	uint32_t temp;

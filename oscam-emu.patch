+void cc_free_card(struct cc_card *card)
+{
+	if(!card)
+	{
+		return;
+	}
+
+	ll_destroy_data(&card->providers);
+	ll_destroy_data(&card->badsids);
+	ll_destroy_data(&card->goodsids);
+	ll_destroy_data(&card->remote_nodes);
+
+	add_garbage(card);
+}

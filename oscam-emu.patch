-		if(account->expirationdate && account->expirationdate < time(NULL))
-			{ ++expired; }
-		if(account->disabled)
-			{ ++disabled; }
-	}
-	cs_log("userdb reloaded: %d accounts loaded, %d expired, %d disabled", nr, expired, disabled);
-	return authptr;

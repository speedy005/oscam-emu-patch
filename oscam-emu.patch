-char *trim(char *txt)
-{
-	int32_t l;
-	char *p1, *p2;
-
-	if(*txt == ' ')
-	{
-		for(p1 = p2 = txt; (*p1 == ' ') || (*p1 == '\t') || (*p1 == '\n') || (*p1 == '\r'); p1++)
-			{ ; }
-
-		while(*p1)
-			{ *p2++ = *p1++; }
-
-		*p2 = '\0';
-	}
-
-	l = cs_strlen(txt);
-	if(l > 0)
-	{
-		for(p1 = txt + l - 1; l > 0 && ((*p1 == ' ') || (*p1 == '\t') || (*p1 == '\n') || (*p1 == '\r')); *p1-- = '\0', l--)
-			{ ; }
-	}
-	return txt;
-}
-
-char *trim2(char *txt)
-{
-	int32_t i, n;
-
-	for(i = n = 0; i < (int32_t)cs_strlen(txt); i++)
-	{
-		if(txt[i] == ' ' || txt[i] == '\t') continue;
-		if(txt[i] == '#') {break;}
-		txt[n] = txt[i];
-		n++;
-	}
-	txt[n] = '\0';
-
-	return txt;
-}

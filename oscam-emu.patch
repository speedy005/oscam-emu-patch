-	uint32_t i;
-
-	for(i = 0; i < dst_len; i++)
-	{
-		rand_pool_pos++; // Races are welcome...
-		dst[i] = rand() ^ rand_pool[rand_pool_pos % RAND_POOL_SIZE];
-	}
-}

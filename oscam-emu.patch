-static void doIp(uint8_t data[])
-{
-	uint8_t j, k;
-	uint8_t val;
-	uint8_t buf[8];
-	uint8_t *p;
-	uint8_t i = 8;
-	memset(buf, 0, sizeof(buf));
-
-	for(i = 0; i < 8; i++)
-	{
-		val = data[i];
-		p = &buf[3];
-		j = 4;
-
-		do
-		{
-			for(k = 0; k <= 4; k += 4)
-			{
-				p[k] >>= 1;
-				if(val & 1) { p[k] |= 0x80; }
-				val >>= 1;
-			}
-			p--;
-		}
-		while(--j);
-	}
-
-	memcpy(data, buf, 8);
-}

-static void ReverseMem(uint8_t *vIn, int32_t len)
-{
-	uint8_t temp;
-	int32_t i;
-
-	for(i = 0; i < (len / 2); i++)
-	{
-		temp = vIn[i];
-		vIn[i] = vIn[len - i - 1];
-		vIn[len - i - 1] = temp;
-	}
-}

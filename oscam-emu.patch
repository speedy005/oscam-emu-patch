+static void streamrelay_auth_client(struct s_client *cl)
+{
+	int32_t ok = 0;
+	struct s_auth *account;
+
+	for (account = cfg.account; cfg.stream_relay_user && account; account = account->next)
+	{
+		if ((ok = streq(cfg.stream_relay_user, account->usr)))
+			{ break; }

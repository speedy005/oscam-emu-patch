-			new_push_client->next_push=cw->pushout_client;
-			cw->pushout_client=new_push_client;
-		}
-
-		SAFE_RWLOCK_UNLOCK(&cw->pushout_client_lock);
-		return 0;
-	}
-	else
-	{
-		SAFE_RWLOCK_UNLOCK(&cw->pushout_client_lock);
-		return 1;
-	}
-}

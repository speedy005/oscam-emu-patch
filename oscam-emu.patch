-	return l;
-}
-
-void ll_destroy(LLIST **pl)
-{
-	LLIST *l = *pl;
-	if(!l || l->flag) { return; }
-	*pl = NULL;
-	ll_clear(l);
-
-	_destroy(l);
-}
-
-void ll_destroy_data(LLIST **pl)
-{
-	LLIST *l = *pl;
-	if(!l) { return; }

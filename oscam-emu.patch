-
-		switch(op1 >> 4)
-		{
-			case 0x0: // j / jump
-				JUMP(operand);
-				CLEAR_OP();
-				break;
-
-			case 0x1: // ldlp
-				PUSH(ctx->Wptr + (operand * 4));
-				CLEAR_OP();
-				break;
-
-			case 0x2: // positive prefix

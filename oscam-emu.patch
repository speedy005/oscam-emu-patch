+static void l2_des(uint8_t *data, uint8_t *key, uint8_t algo)
+{
+	uint8_t i, k0[22], k1[22];
+
+	memcpy(k0, key, 22);
+	memcpy(k1, key, 22);
+
+	cw_48_key(k0, k1, algo);
+	prep_key(k1);
+
+	for (i = 0; i < 2; i++)
+	{
+		ls_des_key(k1, 15);
+		des_round(data, k1);
+	}
+}
+
+static void r2_des(uint8_t *data, uint8_t *key, uint8_t algo)
+{
+	uint8_t i, k0[22], k1[22];
+
+	memcpy(k0, key, 22);
+	memcpy(k1, key, 22);
+
+	cw_48_key(k0, k1, algo);
+	prep_key(k1);
+
+	for (i = 0; i < 2; i++)
+	{
+		ls_des_key(k1, 15);
+	}
+
+	for (i = 0; i < 2; i++)
+	{
+		des_round(data, k1);
+		rs_des_subkey(k1, 1);
+	}
+
+	swap_data(data);
+}
+
+static void cw_des(uint8_t *data, uint8_t *inkey, uint8_t m)
+{
+	uint8_t key[22], i;
+
+	memcpy(key, inkey + 9, 8);
+	prep_key(key);
+
+	for (i = 16; i > 0; i--)
+	{
+		if (m == 1)
+		{
+			ls_des_key(key, (uint8_t) (i - 1));
+		}
+
+		des_round( data ,key);
+
+		if (m == 0)
+		{
+			rs_des_subkey(key, (uint8_t) (i - 1));
+		}
+	}
+}
+
+static void cw_dec_enc(uint8_t *d, uint8_t *k, uint8_t a, uint8_t m)
+{
+	uint8_t n = m & 1;
+
+	l2_des(d, k, a);
+	cw_des(d, k, n);
+	r2_des(d, k, a);
+
+	if (m & 2)
+	{
+		swap_key(k);
+	}
+}

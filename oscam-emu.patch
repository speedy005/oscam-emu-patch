+	struct s_ecmpids_matrix ECMpids[ECM_PIDS_MATRIX];
+	int32_t EMMpidcount;
+	struct s_emmpids_matrix EMMpids[ECM_PIDS_MATRIX];
+	int32_t STREAMpidcount;
+	uint16_t STREAMpids[ECM_PIDS_MATRIX];
+	int32_t pidindex;
+	int32_t curindex;
+	int32_t tries;
+	int32_t max_status;
+	uint16_t program_number;
+	uint8_t lastcw[2][8];

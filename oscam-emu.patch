+       ·  gbox reader
+
+	   [reader]
+	   label    = mygboxreader
+	   protocol = gbox
+	   device   = 192.168.0.4,45678,56789
+	   user     = user4
+	   password = password4
+	   group    = 11
+	   caid     = 1100
+

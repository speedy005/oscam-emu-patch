-uint16_t ccitt_crc(uint8_t *data, size_t length, uint16_t seed, uint16_t final)
-{
-	size_t count;
-	uint32_t crc = seed;
-	uint32_t temp;
-
-	for (count = 0; count < length; ++count)
-	{
-		temp = (*data++ ^ (crc >> 8)) & 0xff;
-		crc = ccitt_crc_table[temp] ^ (crc << 8);
-	}
-	return (uint16_t)(crc ^ final);
-}

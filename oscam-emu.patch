+static void monitor_login(char *usr)
+{
+	char *pwd = NULL;
+	int8_t res = 0;
+	if((usr) && (pwd = strchr(usr, ' ')))
+		{ * pwd++ = 0; }
+	if(pwd)
+		{ res = monitor_auth_client(trim(usr), trim(pwd)); }
+	else
+		{ res = monitor_auth_client(NULL, NULL); }
+
+	if(res == -1)
+	{
+		cs_disconnect_client(cur_client());
+		return;
+	}
+	monitor_send_login();
+}

-
-	for(i = 0; i < 8; i++)
-	{
-		val = 0;
-		for(j = 0; j < 6; j++)
-		{
-			bit = PC2[i][j];
-			if(bit < 29)
-			{
-				bit = 28 - bit;
-				p = left;
-			}
-			else
-			{
-				bit = 56 - bit;
-				p = right;
-			}
-			val <<= 1;

-			}
-			reader_set_defaults(rdr);
-			continue;
-		}
-
-		if(!tag)
-			{ continue; }
-		if(!(value = strchr(token, '=')))
-			{ continue; }
-		*value++ = '\0';
-		chk_reader(trim(strtolower(token)), trim(value), rdr);

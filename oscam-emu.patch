+	if (cs_malloc(&osi.cert_serial, cs_strlen(hex) + 1))
+		cs_strncpy(osi.cert_serial, strtolower(hex), cs_strlen(hex) + 1);
+	OPENSSL_free(hex);
+	BN_free(bn);

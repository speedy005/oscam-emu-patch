+/**
+ * fail_factor is multiplied to the reopen_time. This function increases the fail_factor
+ **/
+static void inc_fail(READER_STAT *s)
+{
+	if(s->fail_factor <= 0)
+		{ s->fail_factor = 1; }
+	else
+		{ s->fail_factor++; } // inc by one at the time
+}

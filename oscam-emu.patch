-					dwtime = d->dwtime;
-					awtime = d->awtime;
-					break;
-				}
-			}
-
-		}
-
-	}
-	if(awtime > 0 && (dwtime <= 0 || awtime==dwtime) ) //if awtime==dwtime useless check hitcache
-	{
-		return awtime;
-	}
-	if(cl == NULL)
-	{
-		if(dwtime < 0)
-			{ dwtime = 0; }

-/**
- * maxparallel - Helper: Clear a slot
- */
-static void clear_slot(struct s_parallel_slot *slot)
-{
-	slot->srvid = 0;
-	slot->ecm_interval = 0;
-	slot->client = NULL;
-	memset(&slot->last_ecm, 0, sizeof(struct timeb));

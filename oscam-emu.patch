+static uint16_t get_channel_group(uint32_t channel_hash)
+{
+	uint8_t tmp[2];
+	uint16_t group = 0;
+
+	if (channel_hash && emu_find_key('P', channel_hash, 0x00000000, "GROUP", tmp, 2, 0, 0, 0, NULL))
+	{
+		group = b2i(2, tmp);
+	}
+
+	return group;
+}

-static int32_t mcrWriteDisplayAscii(struct s_reader *reader, unsigned char data, unsigned char timeout)
-{
-	unsigned char buff[3];
-	buff[0] = 0x61;
-	buff[1] = data;
-	buff[2] = timeout;

+/* Safe string copy - always null-terminates */
+static void safe_strncpy(char *dst, const char *src, size_t size)
+{
+	if(size == 0)
+		{ return; }
+	size_t i;
+	for(i = 0; i < size - 1 && src[i] != '\0'; i++)
+	{
+		dst[i] = src[i];
+	}
+	dst[i] = '\0';
+}

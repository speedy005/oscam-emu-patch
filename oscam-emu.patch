-
-		case 8:
-			for(i = 0; i < 8; ++i)
-			{
-				data[i] = v1[i] ^ v2[i];
-			}
-			break;
-
-		case 4:
-			for(i = 0; i < 4; ++i)
-			{
-				data[i] = v1[i] ^ v2[i];
-			}
-			break;
-
-		default:
-			while(len--)

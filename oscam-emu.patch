+char *get_servicename_or_null(struct s_client *cl, uint16_t srvid, uint32_t provid, uint16_t caid, char *buf, uint32_t buflen)
+{
+	return __get_servicename(cl, srvid, provid, caid, buf, buflen, false);
+}

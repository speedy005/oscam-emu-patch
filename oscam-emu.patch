+		rdr->auprovid = 0;
+		if(cs_strlen(value))
+			{ rdr->auprovid = a2i(value, 3); }
+		return;
+	}
+	if(rdr->auprovid)
+		{ fprintf_conf(f, token, "%06X\n", rdr->auprovid); }
+	else if(cfg.http_full_cfg)
+		{ fprintf_conf(f, token, "\n"); }
+}

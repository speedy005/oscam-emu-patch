+static void rs_des_subkey(uint8_t *k, uint8_t rotate_counter)
+{
+	uint8_t rnd[] = { 1, 1, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 1 };
+
+	rs_des_key(k, rnd[rotate_counter]);
+}

+static void prep_key(uint8_t *key)
+{
+	int32_t round_counter = 6, i, a;
+	uint8_t DES_key[8], j;
+
+	key[7] = 6;
+	memset(DES_key, 0, 8);
+
+	do
+	{
+		a = 7;
+		i = key[7];
+		j = key[round_counter];
+
+		do
+		{
+			DES_key[i] = ( (DES_key[i] * 2) | ((j & 1) ? 1 : 0) ) & 0xFF;
+
+			j /= 2;
+			i--;
+
+			if (i < 0)
+			{
+				i = 6;
+			}
+			a--;
+		}
+		while (a >= 0);
+
+		key[7] = i;
+		round_counter--;
+	}
+	while (round_counter >= 0);
+
+	a = DES_key[4];
+	DES_key[4] = DES_key[6];
+	DES_key[6] = a;
+	DES_key[7] = (DES_key[3] * 16) & 0xFF;
+
+	memcpy(key, DES_key, 8);
+	rs_des_key(key, 4);
+}

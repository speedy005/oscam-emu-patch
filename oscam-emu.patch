+int32_t webif_read(char *buf, int32_t num, FILE *f)
+{
+	errno = 0;
+#ifdef WITH_SSL
+	if(ssl_active)
+	{
+		return SSL_read((SSL *)f, buf, num);
+	}
+	else
+#endif
+		return read(fileno(f), buf, num);
+}

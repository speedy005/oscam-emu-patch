-		uint8_t _cwe0[8];
-		uint8_t _cwe1[8];
-
-		if(cta_res[78] == 0x01 || reader->forcecwswap)
-		{
-			memcpy(_cwe0, &cta_res[52], 0x08);
-			memcpy(_cwe1, &cta_res[28], 0x08);
-		}
-		else
-		{
-			memcpy(_cwe0, &cta_res[28], 0x08);
-			memcpy(_cwe1, &cta_res[52], 0x08);
-		}
-
-		if(cta_res[27] == 0x5C)
-		{
-			uint8_t cta_res144 = cta_res[144];

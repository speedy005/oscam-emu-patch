-	int32_t n;
-	struct s_serial_client *serialdata = client->serialdata ;
-	if(!client->pfd) { return (0); }
-	cs_ftime(&serialdata->tps);
-	serialdata->tpe = client->serialdata->tps;
-	add_ms_to_timeb(&serialdata->tpe, serialdata->oscam_ser_timeout);

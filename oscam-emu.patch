+static int32_t sr_init_locks(struct s_reader *UNUSED(reader))
+{
+	if (!init_lock) {
+	    init_lock = 1;
+		cs_lock_create(__func__, &sr_lock, "sr_lock", 5000);
+	}
+
+	return OK;
+}

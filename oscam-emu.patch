-static void sc8in1_display(struct s_reader *reader, char *message)
-{
-	struct sc8in1_data *crdr_data = reader->crdr_data;
-	if(!crdr_data->mcr_type)
-		{ return; }
-	char msg[4] = "   ";
-	if(cs_strlen(message) >= 3)
-	{
-		msg[0] = message[0];
-		msg[1] = message[1];
-		msg[2] = message[2];

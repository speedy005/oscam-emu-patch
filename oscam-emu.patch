+						if(!memcmp(rdr->sa[i], ep->hexserial, 0x03))
+						{
+							return 1;
+						}
+					}
+				}
+				else if (!memcmp(rdr->hexserial + 2, ep->hexserial, 0x04))
+				{
+					ep->type = UNIQUE;
+					return 1;
+				}
+				else if ((ep->emm[5] == 0x04) && (ep->emm[6] == 0x70))
+				{
+					ep->type = GLOBAL;
+					return 1;
+				}
+				return 0;
+
+			case 0x87:
+				memset(ep->hexserial, 0x00, 0x08);
+				ep->hexserial[0] = ep->emm[5];

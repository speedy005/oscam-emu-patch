-		checksum[2] ^= buf[counter * 4 + 1];
-		checksum[1] ^= buf[counter * 4 + 2];
-		checksum[0] ^= buf[counter * 4 + 3];
-	}
-
-	return checksum[3] << 24 | checksum[2] << 16 | checksum[1] << 8 | checksum[0];
-}

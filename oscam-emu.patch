-		if(ret)
-		{
-			rdr_log(reader, "Couldn't read config descriptor, using default packet size");
-			return packet_size;
-		}
-
-		if(crdr_data->interface < configDesc->bNumInterfaces)
-		{
-			interface = configDesc->interface[crdr_data->interface];

-uint32_t gbox_get_provid(uint32_t caprovid)
-{
-	uint32_t provid = 0;
-
-	switch(caprovid >> 24)
-	{
-		case 0x05: // ViXS
-			provid = caprovid & 0xFFFFFF;
-			break;
-
-		case 0x0D: // Cryptoworx
-			provid = (caprovid >> 8) & 0xFF;
-			break;
-
-		default:
-			provid = caprovid & 0xFFFF;
-			break;
-	}
-	return provid;
-}

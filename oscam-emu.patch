+int32_t can_use_ext(struct cc_card *card)
+{
+	if(card->card_type == CT_REMOTECARD)
+		{ return card->is_ext; }
+
+	if(card->sidtab)
+		{ return (card->sidtab->num_srvid > 0); }
+	else
+		{ return ll_count(card->goodsids) || ll_count(card->badsids); }
+	return 0;
+}

+
+static uint8_t xor(const uint8_t *cmd, int32_t cmdlen)
+{
+	int32_t i;
+	uint8_t checksum = 0x00;
+	for(i = 0; i < cmdlen; i++)
+		{ checksum ^= cmd[i]; }
+	return checksum;
+}

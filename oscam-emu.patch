-/* Decodes values in a http url. Note: The original value is modified! */
-void urldecode(char *s)
-{
-	int32_t c, c1, n;
-	char *t;
-	t = s;
-	n = cs_strlen(s);
-	while(n > 0)
-	{
-		c = *s++;
-		if(c == '+') { c = ' '; }
-		else if(c == '%' && n > 2)
-		{
-			c = *s++;
-			c1 = c;
-			c = *s++;
-			c = 16 * x2i(c1) + x2i(c);
-			n -= 2;
-		}
-		*t++ = c;
-		n--;
-	}
-	*t = 0;
-}

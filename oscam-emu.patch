-		printf(" / streaming");
-		if (hex_equal(md2, 20, v->expected)) { printf(" [OK]\n"); }
-		else { report_mismatch("SHA1 streaming", v->name, md2, 20, v->expected); failures++; }
-		fflush(stdout);
-	}
-	return failures;
-}

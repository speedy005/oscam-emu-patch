+static void pad_data(uint8_t *data, int len, uint8_t *dataPadded)
+{
+	int i;
+	uint8_t pad[] =
+	{
+		0x01, 0x02, 0x22, 0x04, 0x20, 0x2A, 0x1F, 0x03,
+		0x04, 0x06, 0x02, 0x0C, 0x2B, 0x2B, 0x01, 0x7B
+	};
+
+	for (i = 0; i < len; i++)
+	{
+		dataPadded[i] = data[i];
+	}
+
+	dataPadded[len] = 0x01;
+
+	for (i = len + 1; i < 0x2F; i++)
+	{
+		dataPadded[i] = 0x00;
+	}
+
+	dataPadded[0x2F] = len;
+
+	for (i = 0; i < 16; i++)
+	{
+		dataPadded[0x30 + i] = pad[i];
+	}

-	{
-		return 0;
-	}
-	if (((dw[4] + dw[5] + dw[6]) & 0xFF) != dw[7])
-	{
-		return 0;
-	}
-	if (((dw[8] + dw[9] + dw[10]) & 0xFF) != dw[11])
-	{
-		return 0;

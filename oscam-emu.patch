+				filters[idx].filter[1] = rdr->nuid[2];
+				filters[idx].filter[2] = rdr->nuid[1];
+				filters[idx].filter[3] = rdr->nuid[0];
+				filters[idx].filter[4] = rdr->nuid[3];
+				memset(&filters[idx].mask[0], 0xFF, 5);
+				idx++;
+			}
+
+			*filter_count = idx;
+		}
+
+		return OK;
+	}
+	else if(rdr->cak7type == 1)
+	{

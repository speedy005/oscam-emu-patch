-	}
-	else
-	{
-		memcpy(tmpKey, keyString, passLen);
-	}
-
-	for(i = 0; i < alignedPassLen - passLen; i++)
-	{
-		tmpKey[passLen + i] = (uint8_t)i;
-	}
-
-	xxor(desKey, 8, tmpKey, iv);
-
-	for(i = 0; i < alignedPassLen; i += 8)

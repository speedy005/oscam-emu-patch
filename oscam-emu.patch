-		if((*pserial_errors) > 3)
-		{
-			cs_log("too many errors, reiniting...");
-			break;
-		}
-
-		oscam_ser_auth_client(mbuf[0] & 0xF);
-		switch(mbuf[0] >> 4)
-		{
-			case IS_ECM:
-				oscam_ser_process_ecm(mbuf + 1, n - 1);
-				break;
-			case IS_PMT:
-				oscam_ser_process_pmt(mbuf + 1, n - 1);

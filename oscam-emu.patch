+char *mk_t_nano(uint16_t nano)
+{
+	int32_t i, pos = 0, needed = 0;
+
+	for(i = 0; i < 16; i++)
+	{
+		if((1 << i) & nano)
+			{ needed++; }
+	}
+
+	char *value;
+	if(nano == 0xFFFF)
+	{
+		if(!cs_malloc(&value, 4)) { return ""; }
+		snprintf(value, 4, "all");
+	}
+	else
+	{
+		if(needed == 0 || !cs_malloc(&value, needed * 3 + 1)) { return ""; }
+
+		value[0] = '\0';
+		for(i = 0; i < 16; i++)
+		{
+			if((1 << i) & nano)
+				{ pos += snprintf(value + pos, (needed * 3) + 1 - pos, "%s%02x", pos ? "," : "", (i + 0x80)); }
+		}
+	}
+	return value;
+}

-	if(!rdr || !client || !rdr->blocked_services)
-		return 0;
-
-	LL_ITER it = ll_iter_create(rdr->blocked_services);
-	struct s_blocked_client *bc;
-	while((bc = ll_iter_next(&it)))
-	{
-		if(bc->client == client && bc->srvid == srvid)
-			return 1;
-	}
-	return 0;

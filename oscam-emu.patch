-char *remove_white_chars(char *txt)
-{
-	char *p1 = txt, *p2 = txt;
-
-	if(NULL != p1)
-	{
-		while('\0' != *p1)
-		{
-			if((' ' != *p1) && ('\t' != *p1) && ('\n' != *p1) && ('\r' != *p1))
-			{
-				*p2++ = *p1;
-			}
-			p1++;
-		}
-		*p2 = '\0';
-	}
-	return txt;
-}

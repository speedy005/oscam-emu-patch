-		prevCaid = current->caid;
-		prevIdent = current->ident;
-		prevKeyid = current->keyid;
-		current = current->next;
-	}
-
-	/* Set everything back and now create the string */
-	current = rdr->aes_list;
-	prevCaid = 0;
-	prevIdent = 0;
-	prevKeyid = 0;
-	char tmp[needed];

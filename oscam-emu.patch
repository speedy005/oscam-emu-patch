-/** swap endianness (int) */
-static void SwapLBi(uint8_t *buff, int32_t len)
-{
-#if __BYTE_ORDER != __BIG_ENDIAN
-	return;
-#endif
-
-	int32_t i;
-	uint8_t swap[4];
-
-	for(i = 0; i < len / 4; i++)
-	{
-		memcpy(swap, buff, 4);
-		buff[0] = swap[3];
-		buff[1] = swap[2];
-		buff[2] = swap[1];
-		buff[3] = swap[0];
-		buff += 4;
-	}
-}

+__attribute__ ((noreturn)) static void die(const char *s, ...)
+{
+	va_list args;
+	va_start(args, s);
+	fprintf(stderr, "ERROR: ");
+	vfprintf(stderr, s, args);
+	if(s[strlen(s) - 1] != '\n')
+		{ fprintf(stderr, "\n"); }
+	va_end(args);
+	exit(EXIT_FAILURE);

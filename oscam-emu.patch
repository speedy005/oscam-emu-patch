-
-	if(*count >= listsize)
-	{
-		return;
-	}
-
-	for(i = 0; i < *count; i++)
-	{
-		if(caidlist[i] == caid)
-		{
-			exists = 1;
-			break;
-		}
-	}
-
-	if(!exists)
-	{
-		caidlist[*count] = caid;

-/* Checks whether an array has at least one non-zero byte.
-   length specifies the maximum length to check for. */
-int32_t array_has_nonzero_byte(uint8_t *value, int32_t length)
-{
-	if(!value)
-	{
-		return 0;
-	}
-
-	int32_t i;
-	for(i = 0; i < length; i++)
-	{
-		if(value[i] > 0)
-		{
-			return 1;
-		}
-	}
-	return 0;
-}
